<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-bids-table" author="imbuy">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bids"/>
            </not>
        </preConditions>
        <createTable tableName="bids">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lot_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="bidder_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-bids-indexes" author="imbuy">
        <preConditions onFail="MARK_RAN">
            <and>
                <not>
                    <indexExists indexName="idx_bids_lot_id" tableName="bids"/>
                </not>
                <not>
                    <indexExists indexName="idx_bids_bidder_id" tableName="bids"/>
                </not>
                <not>
                    <indexExists indexName="idx_bids_created_at" tableName="bids"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="idx_bids_lot_id" tableName="bids">
            <column name="lot_id"/>
        </createIndex>
        <createIndex indexName="idx_bids_bidder_id" tableName="bids">
            <column name="bidder_id"/>
        </createIndex>
        <createIndex indexName="idx_bids_created_at" tableName="bids">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

