<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-lots-table" author="imbuy">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="lots"/>
            </not>
        </preConditions>
        <createTable tableName="lots">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="start_price" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="current_price" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="bid_step" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="BIGINT"/>
            <column name="winner_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="TIMESTAMP"/>
            <column name="end_date" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-lots-indexes" author="imbuy">
        <preConditions onFail="MARK_RAN">
            <and>
                <not>
                    <indexExists indexName="idx_lots_owner_id" tableName="lots"/>
                </not>
                <not>
                    <indexExists indexName="idx_lots_category_id" tableName="lots"/>
                </not>
                <not>
                    <indexExists indexName="idx_lots_status" tableName="lots"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="idx_lots_owner_id" tableName="lots">
            <column name="owner_id"/>
        </createIndex>
        <createIndex indexName="idx_lots_category_id" tableName="lots">
            <column name="category_id"/>
        </createIndex>
        <createIndex indexName="idx_lots_status" tableName="lots">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

